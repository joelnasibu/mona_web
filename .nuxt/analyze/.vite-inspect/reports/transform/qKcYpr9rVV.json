      "result": "\r\n.footer-title {\r\n  font-weight: bold;\r\n  text-transform: capitalize;\r\n  margin-bottom: 0.8rem;\r\n  font-size: 1rem;\r\n  color: #fff;\r\n  position: relative;\r\n  display: inline-block;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.footer-title::after {\r\n  content: \"\";\r\n  display: block;\r\n  width: 30px;\r\n  height: 2px;\r\n  background: rgba(var(--v-theme-secondary));\r\n  margin-top: 4px;\r\n}\r\n\r\n.footer-text {\r\n  color: #ddd;\r\n  font-size: 0.8rem;\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 0.6rem;\r\n  margin-bottom: 0.4rem;\r\n}\r\n\r\n.footer-icon {\r\n  /* width: 20px;\r\n  height: 20px; */\r\n  color: rgba(var(--v-theme-secondary));\r\n  flex-shrink: 0;\r\n}\r\n\r\n.privacy-links {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.5rem;\r\n}\r\n.privacy-link {\r\n  color: #ddd;\r\n  font-size: 0.8rem;\r\n  text-decoration: none;\r\n}\r\n.privacy-link:hover {\r\n  color: rgba(var(--v-theme-secondary));\r\n}\r\n\r\n.social-links {\r\n  display: flex;\r\n  gap: 0.8rem;\r\n}\r\n.social-link {\r\n  color: #fff;\r\n  font-size: 1.2rem;\r\n}\r\n.social-link:hover {\r\n  color: rgba(var(--v-theme-secondary));\r\n}\r\n\r\n.footer-bottom-text {\r\n  color: #e6e3e1;\r\n}\r\n.footer-link {\r\n  color: rgba(var(--v-theme-secondary));\r\n  text-decoration: none;\r\n}\r\n.footer-link:hover {\r\n  color: #fff;\r\n}\r\n\r\n/* Responsive */\r\n@media (max-width: 960px) {\r\n  .footer-title {\r\n    font-size: 0.95rem;\r\n  }\r\n  .footer-row {\r\n    row-gap: 1.5rem;\r\n  }\r\n}\r\n@media (min-width: 960px) {\r\n  .footer-row > .v-col {\r\n    margin-bottom: 0;\r\n  }\r\n}\r\n@media (max-width: 600px) {\r\n  .footer-title {\r\n    font-size: 0.9rem;\r\n  }\r\n}\r\n",
