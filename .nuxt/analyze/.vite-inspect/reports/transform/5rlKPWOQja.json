ttp(baseURL, {\r\n          method: 'POST',\r\n          body\r\n        })\r\n        this.app.load(false)\r\n        this.app.toggleSnackbar({\r\n          status: true,\r\n          type: 'success',\r\n          message: res.message ?? 'Role created successfully!'\r\n        })\r\n      } catch (e) {\r\n        this.helpers.errorHandler(e)\r\n      }\r\n    }\r\n  }\r\n})",
