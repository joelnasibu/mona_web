rorHandler(e);\r\n      }\r\n    },\r\n    async deleteType(type) {\r\n      this.app.setError(false);\r\n      this.app.load(true);\r\n      try {\r\n        const res = await this.http(`${baseURL}/${type}`, {\r\n          method: \"DELETE\",\r\n        });\r\n        this.app.load(false);\r\n        this.app.toggleSnackbar({\r\n          status: true,\r\n          type: \"success\",\r\n          message: res.message ?? \"Type deleted successfully!\",\r\n        });\r\n      } catch (e) {\r\n        this.helpers.errorHandler(e);\r\n      }\r\n    },\r\n  },\r\n});",
