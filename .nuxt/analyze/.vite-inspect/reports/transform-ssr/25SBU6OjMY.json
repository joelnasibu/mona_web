      "result": "\r\n#snackbar {\r\n  min-width: 200px;\r\n  background-color: #fff !important;\r\n  text-align: center;\r\n  border-radius: 5px;\r\n  position: fixed;\r\n  z-index: 10001;\r\n  right: 2%;\r\n  bottom: var(--bottom) !important;\r\n  -webkit-animation: fadein 0.5s, fadeout 0.2s 6s;\r\n  animation: fadein 0.5s, fadeout 0.2s 6s;\r\n}\r\n\r\n/* .animation {\r\n} */\r\n@keyframes fadein {\r\n  from {\r\n    right: 0;\r\n    opacity: 0;\r\n  }\r\n\r\n  to {\r\n    right: 2%;\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@keyframes fadeout {\r\n  from {\r\n    right: 2%;\r\n    opacity: 1;\r\n  }\r\n\r\n  to {\r\n    right: 0;\r\n    opacity: 0;\r\n  }\r\n}\r\n",
