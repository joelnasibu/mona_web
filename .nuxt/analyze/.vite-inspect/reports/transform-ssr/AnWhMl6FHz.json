          "<template>\r\n  <v-footer class=\"footer pt-8 pb-6\">\r\n    <v-container class=\"px-16\" style=\"max-width: 1200px; margin: 0 auto\">\r\n      <v-row\r\n        justify=\"space-between\"\r\n        align=\"start\"\r\n        class=\"text-left\"\r\n        style=\"gap: 0.25rem\"\r\n      >\r\n        <!-- Contact -->\r\n        <v-col cols=\"12\" md=\"3\">\r\n          <h3 class=\"footer-title\">Contact</h3>\r\n          <p class=\"footer-text\">\r\n            <LucideMail class=\"footer-icon\" size=\"20\" />\r\n            info@nairobi-markets.com\r\n          </p>\r\n          <p class=\"footer-text\">\r\n            <LucidePhone class=\"footer-icon\" size=\"20\" />\r\n            +254 10 7836370\r\n          </p>\r\n          <p class=\"footer-text\">\r\n            <LucideMapPin class=\"footer-icon\" size=\"20\" />\r\n            The Nextgen Mall Mombasa Road, Nairobi, <br />\r\n            Suite 17 & 18\r\n          </p>\r\n        </v-col>\r\n\r\n        <!-- About -->\r\n        <v-col cols=\"12\" md=\"3\">\r\n          <h3 class=\"footer-title\">About</h3>\r\n          <p class=\"footer-text\">\r\n            Nairobi Markets connects you with the city's vibrant markets,\r\n            cultural trails, and unique shopping experiences. Explore, shop, and\r\n            enjoy authentic Kenyan life.\r\n          </p>\r\n        </v-col>\r\n\r\n        <!-- Privacy -->\r\n        <v-col cols=\"12\" md=\"3\">\r\n          <h3 class=\"footer-title\">Privacy</h3>\r\n          <div class=\"privacy-links\">\r\n            <NuxtLink to=\"/privacy-policy\" class=\"privacy-link\"\r\n              >Privacy Policy</NuxtLink\r\n            >\r\n            <NuxtLink to=\"/terms\" class=\"privacy-link\"\r\n              >Terms of Service</NuxtLink\r\n            >\r\n          </div>\r\n        </v-col>\r\n\r\n        <!-- Social -->\r\n        <v-col cols=\"12\" md=\"3\">\r\n          <div class=\"social-links mt-4\">\r\n            <a href=\"#\" target=\"_blank\" class=\"social-link\"\r\n              ><LucideInstagram size=\"20\"\r\n            /></a>\r\n            <a href=\"#\" target=\"_blank\" class=\"social-link\"\r\n              ><LucideTwitter size=\"20\"\r\n            /></a>\r\n            <a href=\"#\" target=\"_blank\" class=\"social-link\"\r\n              ><LucideFacebook size=\"20\"\r\n            /></a>\r\n          </div>\r\n        </v-col>\r\n      </v-row>\r\n\r\n      <!-- Footer Bottom -->\r\n      <v-divider class=\"my-6\"></v-divider>\r\n      <v-row justify=\"center\">\r\n        <v-col cols=\"12\" class=\"text-center\">\r\n          <p class=\"footer-bottom-text\">\r\n            © 2025 Nairobi Markets. All rights reserved. Designed by\r\n            <a href=\"https://mijinitech.com\" target=\"_blank\" class=\"footer-link\"\r\n              >MijiniTech</a\r\n            >\r\n          </p>\r\n        </v-col>\r\n      </v-row>\r\n    </v-container>\r\n  </v-footer>\r\n</template>\r\n\r\n<script setup>\r\nimport {\r\n  LucideMail,\r\n  LucidePhone,\r\n  LucideMapPin,\r\n  LucideInstagram,\r\n  LucideTwitter,\r\n  LucideFacebook,\r\n} from \"lucide-vue-next\";\r\n</script>\r\n\r\n<style scoped>\r\n.footer {\r\n  background-color: #032f46;\r\n  color: #e6e3e1;\r\n}\r\n.footer-title {\r\n  font-weight: bold;\r\n  text-transform: uppercase;\r\n  margin-bottom: 1rem;\r\n}\r\n.footer-text {\r\n  color: #e6e3e1;\r\n  font-size: 0.9rem;\r\n  line-height: 1.5;\r\n  display: flex;\r\n  align-items: flex-start; /* Align multi-line text properly with icon */\r\n  gap: 0.8rem;\r\n  margin-bottom: 0.6rem; /* Space between icon and text */\r\n}\r\n\r\n.footer-icon {\r\n  width: 20px;\r\n  height: 20px;\r\n  color: orange;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.privacy-links {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.5rem;\r\n}\r\n.privacy-link {\r\n  color: #fff;\r\n  text-decoration: none;\r\n}\r\n.privacy-link:hover {\r\n  color: orange;\r\n}\r\n.social-links {\r\n  display: flex;\r\n  gap: 1rem;\r\n}\r\n.social-link {\r\n  color: #fff;\r\n  font-size: 1.2rem;\r\n}\r\n.social-link:hover {\r\n  color: orange;\r\n}\r\n.footer-bottom-text {\r\n  font-size: 0.8rem;\r\n  color: #e6e3e1;\r\n  margin-top: 12px;\r\n}\r\n.footer-link {\r\n  color: orange;\r\n  text-decoration: none;\r\n}\r\n.footer-link:hover {\r\n  color: #fff;\r\n}\r\n</style>\r\n"
